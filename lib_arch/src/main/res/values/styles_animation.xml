<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- activity左右切换动画-->
    <style name="Theme.Activity.xxf_animation_navigation_horizontal" parent="@android:style/Animation.Activity">
        <!--
        当我们从 A1 启动 A2 时，A2 出现在屏幕上，这个动画叫做 android:activityOpenEnterAnimation
        当我们从 A1 启动 A2 时，A1 从屏幕上消失，这个动画叫做 android:activityOpenExitAnimation
        当我们从 A2 退出回到 A1 时，A1 出现在屏幕上，这个叫做 android:activityCloseEnterAnimation
        当我们从 A2 退出回到 A1 时，A2 从屏幕上消失，这个叫做 android:activityCloseExitAnimation
        -->
        <item name="android:activityOpenEnterAnimation">@anim/navigation_horizontal_open_enter
        </item>
        <item name="android:activityOpenExitAnimation">@anim/navigation_horizontal_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/navigation_horizontal_close_enter
        </item>
        <item name="android:activityCloseExitAnimation">@anim/navigation_horizontal_close_exit
        </item>
    </style>
    <!-- activity alpha切换动画-->
    <style name="Theme.Activity.xxf_animation_navigation_alpha" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/navigation_alpha_open_enter
        </item>
        <item name="android:activityOpenExitAnimation">@anim/navigation_alpha_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/navigation_alpha_close_enter
        </item>
        <item name="android:activityCloseExitAnimation">@anim/navigation_alpha_close_exit
        </item>
    </style>

</resources>